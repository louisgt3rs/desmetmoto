# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Use the SERVICE ROLE key (not the anon key) — it bypasses RLS
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Feed format ───────────────────────────────────────────────────────────────
# One of: xml | csv | json
FEED_FORMAT=xml

# URL or local file path to the feed (leave empty for JSON REST API)
# Examples:
#   https://flux.partseurope.eu/feed.xml
#   https://flux.partseurope.eu/feed.csv
#   /data/feed.xml
FEED_SOURCE=https://flux.partseurope.eu/feed.xml

# ── Parts Europe credentials ──────────────────────────────────────────────────
# Option A — API key (Bearer token)
PARTS_EUROPE_API_KEY=

# Option B — Basic auth (username + password or FTP credentials)
PARTS_EUROPE_API_USER=
PARTS_EUROPE_API_PASS=

# Option C — REST API base URL (JSON mode only, pagination handled automatically)
PARTS_EUROPE_API_URL=https://api.partseurope.eu/v1/products

# ── Behaviour ─────────────────────────────────────────────────────────────────
# Delay in ms between Supabase writes (respect rate limits)
RATE_LIMIT_MS=100
